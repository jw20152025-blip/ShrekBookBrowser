{
  "name": "shrekbook-browser",
  "version": "0.1.0",
  "description": "ShrekBook Browser — a customizable Chromium browser with ShrekSearch knowledge cards.",
  "main": "app/main.js",
  "author": "ShrekBook",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "search:start": "node search/server.js",
    "search:crawl": "node search/crawler.js",
    "dev": "electron .",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --dir",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "robots-parser": "^3.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.shrekbook.browser",
    "productName": "ShrekBook Browser",
    "artifactName": "ShrekBookBrowser-${version}-${arch}.${ext}",
    "compression": "maximum",
    "asar": true,
    "npmRebuild": true,
    "files": [
      "app/**/*",
      "renderer/**/*",
      "search/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShrekBook Browser",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "ShrekBookBrowser-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jw20152025-blip",
        "repo": "ShrekBookBrowser",
        "releaseType": "release"
      }
    ]
  }
}
